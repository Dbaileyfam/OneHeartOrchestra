# Adobe Fonts — optional if you already set `ADOBE_TYPEKIT_KIT_ID` in src/config/adobeFonts.ts
# https://fonts.adobe.com/fonts/acid-green → Web Project → https://use.typekit.net/<KIT_ID>.css
VITE_ADOBE_FONTS_KIT=

# Optional: override CSS names from embed (default stack uses acid-green-poster)
# VITE_ADOBE_DISPLAY_FAMILY=

# MailerLite embedded form action (Forms → Embedded → HTML tab → form action).
# Public URL, not an API key. Example:
# VITE_MAILERLITE_FORM_ACTION=https://assets.mailerlite.com/jsonp/12345/forms/67890/subscribe
VITE_MAILERLITE_FORM_ACTION=
